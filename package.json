{
  "name": "admin-codex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "api:sync": "node ./scripts/api/sync-openapi.mjs",
    "api:generate": "orval --config orval.config.ts",
    "api:update": "pnpm run api:sync && prettier --write openapi.yaml && pnpm run api:generate",
    "api:check": "pnpm run api:generate && if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git diff --exit-code -- src/shared/api/generated src/shared/api/generated-zod; else echo \"Skipping generated diff check: not a git worktree\"; fi",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.100.6",
    "antd": "^6.3.7",
    "axios": "^1.15.2",
    "dayjs": "^1.11.20",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "react-redux": "^9.3.0",
    "react-router": "^7.14.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/tsdoc": "^0.16.0",
    "@tanstack/react-query-devtools": "^5.100.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "msw": "^2.13.6",
    "orval": "^8.9.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
